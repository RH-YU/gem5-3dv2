// -*- mode:c++ -*-

output exec {{
namespace
{

uint8_t
xaiHartId(ExecContext *xc)
{
    return static_cast<uint8_t>(
            xc->readMiscReg(MISCREG_HARTID) & UINT8_MAX);
}

npu_mvp::NpuCommand
buildXaiCommand(ExecContext *xc, ExtMachInst mach_inst,
                npu_mvp::Opcode opcode, uint64_t rd_value,
                uint64_t rs1_value, uint64_t rs2_value)
{
    const auto &pc_state = xc->pcState().as<RiscvISA::PCState>();

    npu_mvp::NpuCommand command;
    command.opcode = opcode;
    command.pc = pc_state.pc();
    command.raw_instruction = mach_inst.instBits;
    command.rd_value = rd_value;
    command.rs1_value = rs1_value;
    command.rs2_value = rs2_value;
    command.rd = bits(mach_inst, 11, 7);
    command.rs1 = bits(mach_inst, 19, 15);
    command.rs2 = bits(mach_inst, 24, 20);
    command.hart_id = xaiHartId(xc);
    command.npu_mask = static_cast<uint8_t>(
            xc->readMiscReg(MISCREG_REG_NPU) & 0xF);
    if (opcode == npu_mvp::Opcode::SyncSet ||
        opcode == npu_mvp::Opcode::SyncWait) {
        command.sync_src =
                static_cast<npu_mvp::SyncEndpoint>(command.rd & 0x1F);
        command.sync_dst =
                static_cast<npu_mvp::SyncEndpoint>(command.rs1 & 0x1F);
        command.sync_id = command.rs2 & 0x1F;
    }
    if (opcode == npu_mvp::Opcode::WriteDataToGm ||
        opcode == npu_mvp::Opcode::LoadDataFromGm) {
        const uint64_t file_index = rs2_value;
        const std::string file_prefix =
                opcode == npu_mvp::Opcode::WriteDataToGm
                ? "GMInputFile_"
                : "GMOutputFile_";
        command.sim_file_path =
                file_prefix + std::to_string(command.hart_id) + "_" +
                std::to_string(file_index) + ".bin";
        command.gm_physical_address = rs1_value;
        command.file_byte_count = rd_value;
    }
    return command;
}

Fault
sendXaiCommandAtomic(ExecContext *xc, const npu_mvp::NpuCommand &command)
{
    auto *isa = dynamic_cast<RiscvISA::ISA *>(xc->tcBase()->getIsaPtr());
    panic_if(isa == nullptr, "Xai dispatch requires a RISC-V ISA object.");

    auto *port = dynamic_cast<RequestPort *>(
            &xc->tcBase()->getCpuPtr()->getDataPort());
    if (port == nullptr) {
        return std::make_shared<IllegalInstFault>(
                "Xai dispatch requires a request data port",
                command.raw_instruction);
    }

    uint64_t payload = command.raw_instruction;
    auto request = std::make_shared<Request>(
            isa->npuCmdBase(), sizeof(payload), Request::UNCACHEABLE,
            Request::funcRequestorId);
    auto *packet = new Packet(request, MemCmd::WriteReq);
    packet->dataDynamic(new uint8_t[sizeof(payload)]);
    packet->setData(reinterpret_cast<const uint8_t *>(&payload));
    auto *sender_state = new npu_mvp::NpuCommandSenderState(command);
    packet->pushSenderState(sender_state);

    port->sendAtomic(packet);

    panic_if(packet->popSenderState() != sender_state,
             "Xai dispatch sender state stack was corrupted.");
    const auto dispatch_status = sender_state->status;
    delete sender_state;
    delete packet;

    panic_if(dispatch_status == npu_mvp::DispatchStatus::Backpressured,
             "Xai NPU command backpressured; atomic XAI dispatch cannot "
             "stall/retry the CPU yet.");
    if (dispatch_status == npu_mvp::DispatchStatus::Invalid) {
        return std::make_shared<IllegalInstFault>(
                "Xai NPU command dispatch failed",
                command.raw_instruction);
    }
    return NoFault;
}

Fault
dispatchXaiCommand(ExecContext *xc, ExtMachInst mach_inst,
                   npu_mvp::Opcode opcode, uint64_t rd_value,
                   uint64_t rs1_value, uint64_t rs2_value)
{
    const auto command = buildXaiCommand(
            xc, mach_inst, opcode, rd_value, rs1_value, rs2_value);
    return sendXaiCommandAtomic(xc, command);
}

} // anonymous namespace
}};

def template XaiDisasm {{
    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << " x" << RD << ", x" << RS1 << ", x" << RS2;
        return ss.str();
    }
}};

def template XaiDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template XaiConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rd == 0) ? RegId() : RegId(IntRegClass, machInst.rd));
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs1 == 0) ? RegId() : RegId(IntRegClass, machInst.rs1));
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs2 == 0) ? RegId() : RegId(IntRegClass, machInst.rs2));
        %(constructor)s;
    }
}};

def template XaiNoRegConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        %(constructor)s;
    }
}};

def format XaiOp(opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, %(opcode)s, rd_value, rs1_value, rs2_value);
    if (fault != NoFault)
        return fault;
    ''' % { 'opcode': 'npu_mvp::Opcode::' + opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiSyncOp(opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    Fault fault = dispatchXaiCommand(
            xc, machInst, %(opcode)s, 0, 0, 0);
    if (fault != NoFault)
        return fault;
    ''' % { 'opcode': 'npu_mvp::Opcode::' + opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiNoRegConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};
