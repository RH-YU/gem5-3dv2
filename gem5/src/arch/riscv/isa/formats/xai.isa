    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Mte2, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb, %(mte2_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'mte2_opcode': 'npu_mvp::Mte2Opcode::' + mte2_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiMte1Op(mte1_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Mte1, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb,
            npu_mvp::Mte2Opcode::UbToGm, %(mte1_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'mte1_opcode': 'npu_mvp::Mte1Opcode::' + mte1_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Vcu, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb,
            npu_mvp::Mte2Opcode::UbToGm, npu_mvp::Mte1Opcode::L1ToGm,
            %(vcu_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuVectorLoadOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t ub_address = xc->getRegOperand(this, 0);
    Fault fault = dispatchXaiVcuVectorCommand(
            xc, machInst, %(vcu_opcode)s, bits(machInst, 11, 7), 0, 0,
            ub_address);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(1)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiRs1Constructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuVectorStoreOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t ub_address = xc->getRegOperand(this, 0);
    Fault fault = dispatchXaiVcuVectorCommand(
            xc, machInst, %(vcu_opcode)s, 0, 0, bits(machInst, 11, 7),
            ub_address);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(1)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiRs1Constructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuVectorArithOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    Fault fault = dispatchXaiVcuVectorCommand(
            xc, machInst, %(vcu_opcode)s, bits(machInst, 11, 7),
            bits(machInst, 19, 15), bits(machInst, 24, 20), 0);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiNoRegConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuVectorSetvlImmOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t avl = xc->getRegOperand(this, 0);
    const uint64_t eew_encoding = (bits(machInst, 30, 20) >> 3) & 0x7;
    Fault fault = dispatchXaiVcuVectorCommand(
            xc, machInst, %(vcu_opcode)s, 0, 0, 0, 0, avl, eew_encoding);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(1)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiRs1Constructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiVcuVectorSetvlRegOp(vcu_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t avl = xc->getRegOperand(this, 0);
    const uint64_t vtype = xc->getRegOperand(this, 1);
    const uint64_t eew_encoding = (vtype >> 3) & 0x7;
    Fault fault = dispatchXaiVcuVectorCommand(
            xc, machInst, %(vcu_opcode)s, 0, 0, 0, 0, avl, eew_encoding);
    if (fault != NoFault)
        return fault;
    ''' % { 'vcu_opcode': 'npu_mvp::VcuOpcode::' + vcu_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(2)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiRs1Rs2Constructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiSyncOp(sync_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Sync, 0, 0, 0,
            npu_mvp::Mte4Opcode::GmToUb, npu_mvp::Mte2Opcode::UbToGm,
            npu_mvp::Mte1Opcode::L1ToGm, npu_mvp::VcuOpcode::Load,
            npu_mvp::CubeOpcode::MmaFp32_8x16x16,
            npu_mvp::FixpipeOpcode::L0CToL1, %(sync_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'sync_opcode': 'npu_mvp::SyncOpcode::' + sync_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiNoRegConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiGmFileIoOp(gm_file_io_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::GmFileIo, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb,
            npu_mvp::Mte2Opcode::UbToGm, npu_mvp::Mte1Opcode::L1ToGm,
            npu_mvp::VcuOpcode::Load, npu_mvp::CubeOpcode::MmaFp32_8x16x16,
            npu_mvp::FixpipeOpcode::L0CToL1, npu_mvp::SyncOpcode::Set,
            %(gm_file_io_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % {
        'gm_file_io_opcode':
                'npu_mvp::GmFileIoOpcode::' + gm_file_io_opcode
    }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiCubeOp(cube_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Cube, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb,
            npu_mvp::Mte2Opcode::UbToGm, npu_mvp::Mte1Opcode::L1ToGm,
            npu_mvp::VcuOpcode::Load, %(cube_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'cube_opcode': 'npu_mvp::CubeOpcode::' + cube_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiFixpipeOp(fixpipe_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Fixpipe, rd_value, rs1_value,
            rs2_value, npu_mvp::Mte4Opcode::GmToUb,
            npu_mvp::Mte2Opcode::UbToGm, npu_mvp::Mte1Opcode::L1ToGm,
            npu_mvp::VcuOpcode::Load,
            npu_mvp::CubeOpcode::MmaFp32_8x16x16, %(fixpipe_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'fixpipe_opcode': 'npu_mvp::FixpipeOpcode::' + fixpipe_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};
