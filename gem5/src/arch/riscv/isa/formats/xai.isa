// -*- mode:c++ -*-

output exec {{
namespace
{

uint8_t
xaiHartId(ExecContext *xc)
{
    return static_cast<uint8_t>(
            xc->readMiscReg(MISCREG_HARTID) & UINT8_MAX);
}

npu_mvp::NpuCommand
buildXaiCommand(ExecContext *xc, ExtMachInst mach_inst,
                npu_mvp::Opcode opcode, uint64_t rd_value,
                uint64_t rs1_value, uint64_t rs2_value,
                npu_mvp::Mte4Opcode mte4_opcode =
                        npu_mvp::Mte4Opcode::GmToUb,
                npu_mvp::Mte2Opcode mte2_opcode =
                        npu_mvp::Mte2Opcode::UbToGm,
                npu_mvp::Mte1Opcode mte1_opcode =
                        npu_mvp::Mte1Opcode::L1ToGm,
                npu_mvp::VcuOpcode vcu_opcode = npu_mvp::VcuOpcode::Load,
                npu_mvp::CubeOpcode cube_opcode =
                        npu_mvp::CubeOpcode::MmaFp32_8x16x16,
                npu_mvp::FixpipeOpcode fixpipe_opcode =
                        npu_mvp::FixpipeOpcode::L0CToL1,
                npu_mvp::SyncOpcode sync_opcode = npu_mvp::SyncOpcode::Set,
                npu_mvp::GmFileIoOpcode gm_file_io_opcode =
                        npu_mvp::GmFileIoOpcode::WriteDataToNpu)
{
    const auto &pc_state = xc->pcState().as<RiscvISA::PCState>();

    npu_mvp::NpuCommand command;
    command.opcode = opcode;
    switch (opcode) {
      case npu_mvp::Opcode::Mte4:
        command.subopcode = static_cast<uint8_t>(mte4_opcode);
        break;
      case npu_mvp::Opcode::Mte2:
        command.subopcode = static_cast<uint8_t>(mte2_opcode);
        break;
      case npu_mvp::Opcode::Mte1:
        command.subopcode = static_cast<uint8_t>(mte1_opcode);
        break;
      case npu_mvp::Opcode::Vcu:
        command.subopcode = static_cast<uint8_t>(vcu_opcode);
        break;
      case npu_mvp::Opcode::Cube:
        command.subopcode = static_cast<uint8_t>(cube_opcode);
        break;
      case npu_mvp::Opcode::Fixpipe:
        command.subopcode = static_cast<uint8_t>(fixpipe_opcode);
        break;
      case npu_mvp::Opcode::Sync:
        command.subopcode = static_cast<uint8_t>(sync_opcode);
        break;
      case npu_mvp::Opcode::GmFileIo:
        command.subopcode = static_cast<uint8_t>(gm_file_io_opcode);
        break;
    }
    command.pc = pc_state.pc();
    command.raw_instruction = mach_inst.instBits;
    command.rd_value = rd_value;
    command.rs1_value = rs1_value;
    command.rs2_value = rs2_value;
    command.rd = bits(mach_inst, 11, 7);
    command.rs1 = bits(mach_inst, 19, 15);
    command.rs2 = bits(mach_inst, 24, 20);
    command.hart_id = xaiHartId(xc);
    command.npu_mask = static_cast<uint8_t>(
            xc->readMiscReg(MISCREG_REG_NPU) & 0xF);
    if (opcode == npu_mvp::Opcode::Sync) {
        command.sync_src =
                static_cast<npu_mvp::SyncEndpoint>(command.rd & 0x1F);
        command.sync_dst =
                static_cast<npu_mvp::SyncEndpoint>(command.rs1 & 0x1F);
        command.sync_id = command.rs2 & 0x1F;
    }
    if (opcode == npu_mvp::Opcode::GmFileIo) {
        const uint64_t file_index = rs2_value;
        const std::string file_prefix =
                gm_file_io_opcode ==
                npu_mvp::GmFileIoOpcode::WriteDataToNpu
                ? "GMInputFile_"
                : "GMOutputFile_";
        command.sim_file_path =
                file_prefix + std::to_string(command.hart_id) + "_" +
                std::to_string(file_index) + ".bin";
        command.storage_physical_address = rs1_value;
        command.file_byte_count = rd_value;
    }
    return command;
}

npu_mvp::NpuCommand
buildXaiVcuVectorCommand(ExecContext *xc, ExtMachInst mach_inst,
                         npu_mvp::VcuOpcode vcu_opcode,
                         uint8_t destination_register,
                         uint8_t source_register_1,
                         uint8_t source_register_2,
                         uint64_t ub_address,
                         uint64_t avl = 0,
                         uint64_t eew_encoding = 0)
{
    auto command = buildXaiCommand(
            xc, mach_inst, npu_mvp::Opcode::Vcu, 0, ub_address, 0,
            npu_mvp::Mte4Opcode::GmToUb, npu_mvp::Mte2Opcode::UbToGm,
            npu_mvp::Mte1Opcode::L1ToGm, vcu_opcode);
    command.rd = destination_register;
    command.rs1 = source_register_1;
    command.rs2 = source_register_2;
    if (vcu_opcode == npu_mvp::VcuOpcode::Nsetvl) {
        command.rs1_value = avl;
        command.rs2_value = eew_encoding;
    }
    return command;
}

Fault
sendXaiCommandDirect(ExecContext *xc, const npu_mvp::NpuCommand &command)
{
    auto *isa = dynamic_cast<RiscvISA::ISA *>(xc->tcBase()->getIsaPtr());
    panic_if(isa == nullptr, "Xai dispatch requires a RISC-V ISA object.");

    const auto dispatch_status =
            npu_mvp::submitNpuCommandDirect(isa->npuDispatchId(), command);
    if (dispatch_status == npu_mvp::DispatchStatus::Backpressured)
        return std::make_shared<ReExec>();
    if (dispatch_status == npu_mvp::DispatchStatus::Invalid) {
        return std::make_shared<IllegalInstFault>(
                "Xai NPU command dispatch failed",
                command.raw_instruction);
    }
    return NoFault;
}

Fault
dispatchXaiCommand(ExecContext *xc, ExtMachInst mach_inst,
                   npu_mvp::Opcode opcode, uint64_t rd_value,
                   uint64_t rs1_value, uint64_t rs2_value,
                   npu_mvp::Mte4Opcode mte4_opcode =
                           npu_mvp::Mte4Opcode::GmToUb,
                   npu_mvp::Mte2Opcode mte2_opcode =
                           npu_mvp::Mte2Opcode::UbToGm,
                   npu_mvp::Mte1Opcode mte1_opcode =
                           npu_mvp::Mte1Opcode::L1ToGm,
                   npu_mvp::VcuOpcode vcu_opcode = npu_mvp::VcuOpcode::Load,
                   npu_mvp::CubeOpcode cube_opcode =
                           npu_mvp::CubeOpcode::MmaFp32_8x16x16,
                   npu_mvp::FixpipeOpcode fixpipe_opcode =
                           npu_mvp::FixpipeOpcode::L0CToL1,
                   npu_mvp::SyncOpcode sync_opcode = npu_mvp::SyncOpcode::Set,
                   npu_mvp::GmFileIoOpcode gm_file_io_opcode =
                           npu_mvp::GmFileIoOpcode::WriteDataToNpu)
{
    const auto command = buildXaiCommand(
            xc, mach_inst, opcode, rd_value, rs1_value, rs2_value,
            mte4_opcode, mte2_opcode, mte1_opcode, vcu_opcode, cube_opcode,
            fixpipe_opcode, sync_opcode, gm_file_io_opcode);
    return sendXaiCommandDirect(xc, command);
}

Fault
dispatchXaiVcuVectorCommand(ExecContext *xc, ExtMachInst mach_inst,
                            npu_mvp::VcuOpcode vcu_opcode,
                            uint8_t destination_register,
                            uint8_t source_register_1,
                            uint8_t source_register_2,
                            uint64_t ub_address,
                            uint64_t avl = 0,
                            uint64_t eew_encoding = 0)
{
    const auto command = buildXaiVcuVectorCommand(
            xc, mach_inst, vcu_opcode, destination_register, source_register_1,
            source_register_2, ub_address, avl, eew_encoding);
    return sendXaiCommandDirect(xc, command);
}

} // anonymous namespace
}};

def template XaiDisasm {{
    std::string
    %(class_name)s::generateDisassembly(
        Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << " x" << RD << ", x" << RS1 << ", x" << RS2;
        return ss.str();
    }
}};

def template XaiDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        std::string generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const override;
    };
}};

def template XaiConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rd == 0) ? RegId() : RegId(IntRegClass, machInst.rd));
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs1 == 0) ? RegId() : RegId(IntRegClass, machInst.rs1));
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs2 == 0) ? RegId() : RegId(IntRegClass, machInst.rs2));
        %(constructor)s;
    }
}};

def template XaiNoRegConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        %(constructor)s;
    }
}};

def template XaiRs1Constructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs1 == 0) ? RegId() : RegId(IntRegClass, machInst.rs1));
        %(constructor)s;
    }
}};

def template XaiRs1Rs2Constructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs1 == 0) ? RegId() : RegId(IntRegClass, machInst.rs1));
        setSrcRegIdx(_numSrcRegs++,
                (machInst.rs2 == 0) ? RegId() : RegId(IntRegClass, machInst.rs2));
        %(constructor)s;
    }
}};

def format XaiOp(opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, %(opcode)s, rd_value, rs1_value, rs2_value);
    if (fault != NoFault)
        return fault;
    ''' % { 'opcode': 'npu_mvp::Opcode::' + opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

def format XaiMte4Op(mte4_opcode, *flags) {{
    xai_flags = flags + ('IsInteger', 'IsNonSpeculative',)
    code = '''
    const uint64_t rd_value = xc->getRegOperand(this, 0);
    const uint64_t rs1_value = xc->getRegOperand(this, 1);
    const uint64_t rs2_value = xc->getRegOperand(this, 2);
    Fault fault = dispatchXaiCommand(
            xc, machInst, npu_mvp::Opcode::Mte4, rd_value, rs1_value,
            rs2_value, %(mte4_opcode)s);
    if (fault != NoFault)
        return fault;
    ''' % { 'mte4_opcode': 'npu_mvp::Mte4Opcode::' + mte4_opcode }
    iop = InstObjParams(name, Name, 'RiscvStaticInst', code, xai_flags)
    iop.padSrcRegIdx(3)
    header_output = XaiDeclare.subst(iop)
    decoder_output = XaiConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = NoWBExecute.subst(iop) + XaiDisasm.subst(iop)
}};

